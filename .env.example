# ---------------------------------------------------------------------------
# Bitget API - klucz TYLKO DO ODCZYTU (read-only)
# ---------------------------------------------------------------------------
# Jak wygenerować:
#   Bitget -> API Management -> Create API Key -> System-generated API key
#   Uprawnienia (Permissions): zaznacz WYŁĄCZNIE "Read" / "Read-only"
#   NIE zaznaczaj: Trade / Spot Trade / Futures Trade / Withdraw / Transfer
#   IP whitelist: ustaw IP swojego serwera (mocno zalecane)
#
# Skopiuj ten plik jako .env i uzupełnij wartości. Plik .env jest w .gitignore.
# ---------------------------------------------------------------------------

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Opcjonalnie: bazowy URL API (zmieniaj tylko jeśli wiesz co robisz)
# BITGET_BASE_URL=https://api.bitget.com

# Opcjonalnie: kurs przeliczeniowy do waluty wyświetlania (np. USDT -> PLN).
# Podawany ręcznie - skrypt celowo nie odpytuje żadnych zewnętrznych serwisów.
# BITGET_FX_RATE=4.05
# BITGET_FX_LABEL=PLN

# Opcjonalnie: domyślny zakres analizy (YYYY-MM-DD)
# BITGET_START=2024-01-01
